# ==========================================
# ALVERO Fashion E-Commerce — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or real credentials.
# ==========================================

# Public Site URL (used for canonical URLs, hreflang, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Project Credentials (Safe for browser where prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (SERVER-ONLY! NEVER expose to browser or NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Initial Owner Bootstrap Script Credentials (one-time setup only)
BOOTSTRAP_OWNER_EMAIL=owner@alvero.eg
BOOTSTRAP_OWNER_PASSWORD=ChangeThisStrongPassword123!
BOOTSTRAP_OWNER_NAME=ALVERO Founder
